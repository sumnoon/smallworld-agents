# The app runs offline by default. No model requests are made in demo mode.
AGENT_PROVIDER=demo

# Local live cognition: set AGENT_PROVIDER=ollama; use the exact name from ollama list.
AGENT_MODEL=gemma4:31b
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_MODEL_TIMEOUT=120

# Optional cloud alternative: set provider to openai, choose a Responses API
# model supporting structured outputs, and set its key. Ollama does not use this key.
OPENAI_API_KEY=

# Total model requests allowed per server process, including failed requests.
AGENT_MAX_REQUESTS=100
