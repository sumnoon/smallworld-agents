# The app runs offline by default. No model requests are made in demo mode.
AGENT_PROVIDER=demo

# Local live cognition: set AGENT_PROVIDER=ollama; use the exact name from ollama list.
AGENT_MODEL=gemma4:31b
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_MODEL_TIMEOUT=120

# Optional cloud alternative: set provider to openai, choose a Responses API
# model supporting structured outputs, and set its key. Ollama does not use this key.
OPENAI_API_KEY=

# Total model requests allowed per server process, including failed requests.
AGENT_MAX_REQUESTS=100

# Optional semantic memory in live mode. Install with: ollama pull embeddinggemma
# Blank keeps lexical retrieval. Failure falls back to lexical without stopping movement.
AGENT_EMBEDDING_MODEL=
AGENT_MAX_EMBED_REQUESTS=500

# Evaluation ablations; normal operation keeps both on.
AGENT_MEMORY_RETRIEVAL=on
AGENT_REFLECTIONS=on

# Latency defaults: compact context, local schedules, cache-only semantic retrieval.
# Clear errands bypass the model queue; complex requests still use your model.
AGENT_CONTEXT_SIZE=4096
AGENT_ROUTINE_MODEL=off
AGENT_LIVE_EMBEDDINGS=off
# Turn the last two on for model-driven routine choices and fresh embeddings.
# They increase latency, especially when models cannot stay in GPU memory together.
